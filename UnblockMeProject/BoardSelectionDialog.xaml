<Window x:Class="UnblockMeProject.BoardSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Board" Height="450" Width="400" WindowStartupLocation="CenterOwner">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Select Board Configuration:" FontWeight="Bold" Margin="0,0,0,15"/>

        <ComboBox Grid.Row="1" x:Name="BoardComboBox" Margin="0,0,0,15" 
                  SelectionChanged="BoardComboBox_SelectionChanged">
            <ComboBoxItem Content="Board 1"/>
            <ComboBoxItem Content="Board 2"/>
            <ComboBoxItem Content="Board 3"/>
            <ComboBoxItem Content="Board 4"/>
            <ComboBoxItem Content="Board 5"/>
            <ComboBoxItem Content="Board 6"/>
        </ComboBox>

        <!-- Board Preview Images -->
        <Border Grid.Row="2" BorderBrush="White" BorderThickness="1" Margin="0,0,0,0">
            <Grid>
                <!-- Use multiple images with different visibility -->
                <Image x:Name="Board1Image" Visibility="Visible"   Source="Images/Board1.png" Stretch="Uniform" />
                <Image x:Name="Board2Image" Visibility="Collapsed" Source="Images/Board2.png" Stretch="Uniform" />
                <Image x:Name="Board3Image" Visibility="Collapsed" Source="Images/Board3.png" Stretch="Uniform" />
                <Image x:Name="Board4Image" Visibility="Collapsed" Source="Images/Board4.png" Stretch="Uniform" />
                <Image x:Name="Board5Image" Visibility="Collapsed" Source="Images/Board5.png" Stretch="Uniform" />
                <Image x:Name="Board6Image" Visibility="Collapsed" Source="Images/Board6.png" Stretch="Uniform" />

                <!-- Fallback text if images aren't loaded -->
                <TextBlock x:Name="FallbackText" Visibility="Collapsed" 
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Text="Preview not available" />
            </Grid>
        </Border>

        <TextBlock Grid.Row="3" x:Name="BoardDescriptionText" TextWrapping="Wrap" 
                   Margin="0,0,0,15" Height="40"/>

        <TextBlock Grid.Row="4" Text="Select Depth (1-3):" FontWeight="Bold" Margin="0,0,0,10"/>

        <Grid Grid.Row="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Slider Grid.Row="0" Grid.Column="0" x:Name="DepthSlider" Minimum="1" Maximum="3" Value="3" 
                    TickPlacement="BottomRight" TickFrequency="1" IsSnapToTickEnabled="True"
                    Margin="0,0,10,5"/>

            <TextBlock Grid.Row="0" Grid.Column="1" VerticalAlignment="Center">
                <Run Text="{Binding ElementName=DepthSlider, Path=Value, Mode=OneWay}"/>
            </TextBlock>

            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" 
                        Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                <Button x:Name="OkButton" Content="OK" Width="75" Margin="0,0,10,0" 
                        IsDefault="True" Click="OkButton_Click"/>
                <Button x:Name="CancelButton" Content="Cancel" Width="75" 
                        IsCancel="True" Click="CancelButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>